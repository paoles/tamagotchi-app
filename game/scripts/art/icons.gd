static func image(name: String) -> Image:
	return Px.grid_image(G.get(name, G.question))

static func tex(name: String, scale: int = 1) -> Texture2D:
	return Px.cached("icon:%s:%d" % [name, scale], func() -> Image:
		var img := image(name)
		return img if scale == 1 else Px.scaled(img, scale))

static func contact_sheet() -> Image:
	var names := G.keys()
	var cols := 10
	var scale := 4
	var cell := 14
	var rows := ceili(names.size() / float(cols))
	var sheet := Image.create_empty(cols * cell * scale, rows * cell * scale, false, Image.FORMAT_RGBA8)
	sheet.fill(Pal.PANEL)
	for i in names.size():
		var img := Px.scaled(image(names[i]), scale)
		var x := (i % cols) * cell * scale + scale
		var y := (i / cols) * cell * scale + scale
		Px.stamp(sheet, img, x, y)
	return sheet
