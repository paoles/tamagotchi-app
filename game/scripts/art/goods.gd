static func image(id: String) -> Image:
	if G.has(id):
		return Px.grid_image(G[id])
	if id == "ball":
		return Icons.image("play")
	return Image.create_empty(1, 1, false, Image.FORMAT_RGBA8)

static func tex(id: String) -> Texture2D:
	return Px.cached("goods:" + id, func() -> Image: return image(id))

static func contact_sheet() -> Image:
	var ids := G.keys()
	var cols := 8
	var scale := 3
	var cell := 32
	var rows := ceili(ids.size() / float(cols))
	var sheet := Image.create_empty(cols * cell * scale, rows * cell * scale, false, Image.FORMAT_RGBA8)
	sheet.fill(Pal.PANEL)
	for i in ids.size():
		Px.stamp(sheet, Px.scaled(image(ids[i]), scale), (i % cols) * cell * scale + scale, (i / cols) * cell * scale + scale)
	return sheet
